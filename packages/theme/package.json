{
  "name": "@toyo-ui/theme",
  "version": "0.1.0",
  "description": "Design tokens and MUI theme for Toyo-ui.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@toyo-ui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
