{
  "name": "toyo-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @toyo-ui/playground dev",
    "dev:consumer": "pnpm build:packages && pnpm --filter @toyo-ui/consumer-demo dev",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "build": "pnpm build:packages && pnpm build:apps",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:packages && vitest run",
    "test:watch": "vitest",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile.json=.test-report/raw.json; node apps/playground/scripts/normalize-test-report.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm build:packages && pnpm -r run typecheck && pnpm lint && pnpm format:check && vitest run && pnpm verify:consumer && pnpm build:apps",
    "build:apps": "pnpm test:report && pnpm --filter \"./apps/*\" run build",
    "verify:consumer": "pnpm --filter @toyo-ui/consumer-demo run verify:exports"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
